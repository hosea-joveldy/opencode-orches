{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "lsp": true,
  "compaction": {
    "auto": true,
    "threshold": 0.85
  },
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "@vheins/opencode-9router@latest",
    "opencode-memoir",
    "opencode-vibeguard"
  ],
  "mcp": {
    "typeui": {
      "type": "remote",
      "url": "https://mcp.typeui.sh/mcp",
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    }
  },
  "provider": {
    "9router": {
      "name": "9Router",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:20128/v1",
        "apiKey": "{file:~/.secrets/9router-key}",
        "cache": true
      }
    }
  },
  "agent": {
    "orchestrator": {
      "mode": "primary",
      "model": "9router/combo-orchestrator",
      "prompt": "{file:~/.config/opencode/prompts/orchestrator.txt}",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "allow",
        "skill": "allow",
        "typeui_*": "deny"
      }
    },
    "planner": {
      "mode": "subagent",
      "model": "9router/combo-planner",
      "prompt": "{file:~/.config/opencode/prompts/planner.txt}",
      "permission": {
        "edit": "deny",
        "bash": "ask",
        "task": "deny",
        "websearch": "allow",
        "webfetch": "allow",
        "skill": "allow",
        "typeui_*": "deny"
      }
    },
    "designer": {
      "mode": "subagent",
      "model": "9router/combo-designer",
      "prompt": "{file:~/.config/opencode/prompts/designer.txt}",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny",
        "websearch": "allow",
        "webfetch": "allow",
        "skill": "allow",
        "typeui_*": "allow"
      }
    },
    "coder": {
      "mode": "subagent",
      "model": "9router/combo-coder",
      "prompt": "{file:~/.config/opencode/prompts/coder.txt}",
      "permission": {
        "edit": "allow",
        "bash": "ask",
        "task": "allow",
        "lsp": "allow",
        "skill": "allow",
        "typeui_*": "deny"
      }
    },
    "qa": {
      "mode": "subagent",
      "model": "9router/combo-qa",
      "prompt": "{file:~/.config/opencode/prompts/qa.txt}",
      "permission": {
        "edit": "deny",
        "bash": "ask",
        "task": "deny", 
        "lsp": "allow",
        "skill": "allow",
        "typeui_*": "deny",
        "playwright_*": "allow"
      }
    }
  }
}
